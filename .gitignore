# Secrets — never commit
.env

# Encrypted keyfiles and addresses — keep local
secrets/
*.enc
*_prv.enc
*_pub.bin
*_addr.bin
*_addr.png

# Notebook scratch
.ipynb_checkpoints/

# Python virtualenv
.venv/

# macOS
.DS_Store

# Python / build caches
__pycache__/
*.pyc

# Local agent + editor config
.claude/

# LaTeX build artifacts
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc

# Inscription key / session material — never commit
inscriptions_ready/*.bin

